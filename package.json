{
  "name": "capability-hub",
  "version": "0.4.0",
  "type": "module",
  "description": "Capability presets: save a set of MCP servers, Skills and plugin capabilities, and control what each Session exposes.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "LICENSE",
    "README.md",
    "README.zh-CN.md",
    "docs/*.md",
    "host/*.js",
    "locale/*.json",
    "icon.svg"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/namingsohard/dsh-capability-hub.git"
  },
  "homepage": "https://github.com/namingsohard/dsh-capability-hub#readme",
  "bugs": {
    "url": "https://github.com/namingsohard/dsh-capability-hub/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "skills",
    "mcp",
    "capabilities"
  ],
  "engines": {
    "node": ">=22",
    "dsh": ">=0.2.1-rc.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
